{
  "name": "ltx-trainer-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n next,worker -c cyan,yellow \"next dev --port ${PORT:-8675}\" \"tsx src/worker/index.ts\"",
    "dev:next": "next dev --port ${PORT:-8675}",
    "build": "next build",
    "start": "next start --port ${PORT:-8675}",
    "lint": "next lint",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.18",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
